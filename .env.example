# JobApplier local configuration
# Copy to .env. Never commit .env or portal credentials.

DATABASE_URL=sqlite:///job_applications.db
PROFILE_PATH=data/candidate_profile.json
DRAFTS_DIR=data/drafts
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# 0=tracking, 1=parse/score, 2=drafts, 3=package preparation,
# 4=human-approved local assistance. Level 5 is not implemented.
AUTOMATION_LEVEL=3

# Search preferences used only by legacy/local discovery helpers.
MIN_MATCH_SCORE=60
MAX_JOB_AGE_DAYS=30
REQUIRE_INTERNSHIP=true

# Optional draft-generation provider. Deterministic local drafts work without it.
OPENAI_API_KEY=

# Safety flags below are documented for compatibility only. Code enforces false,
# false, and true respectively even if different values are supplied.
AUTO_MODE=false
AUTO_APPLY_ENABLED=false
STOP_BEFORE_SUBMIT=true

# No LinkedIn, Workday, or other job-portal passwords belong in this file.
