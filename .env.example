# JobApplier local configuration
# Copy to .env. Never commit .env or portal credentials.

DATABASE_URL=sqlite:///job_applications.db
PROFILE_PATH=data/candidate_profile.json
DRAFTS_DIR=data/drafts
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# 0=tracking, 1=parse/score, 2=drafts, 3=package preparation,
# 4=user-confirmed reviewed link-and-checklist handoff.
# No protected-board automation is implemented. Level 5 is unavailable.
AUTOMATION_LEVEL=3

# Compatibility values are ignored by the supported dashboard. Submission and
# protected-board automation cannot be enabled by environment variables.
AUTO_MODE=false
AUTO_APPLY_ENABLED=false
STOP_BEFORE_SUBMIT=true

# No LinkedIn, Workday, or other job-portal passwords belong in this file.
