# JobApplier local configuration
# Copy to .env. Never commit .env or portal credentials.

DATABASE_URL=sqlite:///job_applications.db
PROFILE_PATH=data/candidate_profile.json
DRAFTS_DIR=data/drafts
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# 0=tracking, 1=parse/score, 2=drafts, 3=package preparation,
# 4=user-confirmed reviewed link-and-checklist handoff.
# No protected-board automation is implemented. Level 5 is unavailable.
AUTOMATION_LEVEL=3

# Compatibility values are ignored by the supported dashboard. Submission and
# protected-board automation cannot be enabled by environment variables.
AUTO_MODE=false
AUTO_APPLY_ENABLED=false
STOP_BEFORE_SUBMIT=true

# No LinkedIn, Workday, or other job-portal passwords belong in this file.

# Freshness window for the job list (hours for "new", days for max age).
NEW_JOB_HOURS=12
MAX_JOB_AGE_DAYS=1

# ── Pokémon card sniper (python3 snipe.py) ──
SNIPE_WATCHLIST=data/cardsnipe_watchlist.json
SNIPE_DATABASE_URL=sqlite:///cardsnipe.db
SNIPE_POLL_SECONDS=45
# Seconds before auction end to place the bid.
SNIPE_LEAD_SECONDS=6
# eBay Browse API (free developer keys). Blank = Chrome fallback.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_MARKETPLACE=EBAY_CA
EBAY_DOMAIN=ebay.ca
EBAY_CURRENCY=CAD
# Facebook Marketplace (uses a logged-in Chrome profile; log in once with `python3 snipe.py login`).
FB_CITY=toronto
FB_DAYS_SINCE_LISTED=1
FB_AUTO_MESSAGE=false
FB_MESSAGE_TEMPLATE=Hi! Is this still available?
SNIPE_NOTIFY_MACOS=true
SNIPE_OPEN_IN_BROWSER=true
# Optional Discord/Slack-compatible webhook for deal alerts.
SNIPE_WEBHOOK_URL=
SNIPE_HEADLESS=false

# Market valuation: a card's value per grade = cheapest of TCGPlayer / PriceCharting / eBay sold.
SNIPE_PRICE_TTL_HOURS=6          # re-fetch values after this many hours
SNIPE_USD_RATE=1.38              # USD -> EBAY_CURRENCY fallback when the FX lookup is offline
SNIPE_EBAY_SOLD_COMPS=true       # read eBay sold listings too (needs `make login` on eBay)
COLLECTR_SHOWCASE_URL=           # your public https://app.getcollectr.com/showcase/profile/... link
